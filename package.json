{
  "name": "html-visual-editor",
  "publisher": "ezlifetech",
  "displayName": "HTML Visual Editor",
  "description": "WYSIWYG HTML editor with real-time preview, drag-and-drop, and component library",
  "version": "0.1.10",
  "repository": {
    "type": "git",
    "url": "https://github.com/ezlifetech/html-visual-editor"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "contributes": {
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "*.html": "htmlVisualEditor.editor",
        "*.md": "htmlVisualEditor.editor"
      }
    },
    "customEditors": [
      {
        "viewType": "htmlVisualEditor.editor",
        "displayName": "HTML Visual Editor",
        "selector": [
          {
            "filenamePattern": "*.html"
          },
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "htmlVisualEditor.open",
        "title": "Open with HTML Visual Editor"
      },
      {
        "command": "htmlVisualEditor.createThemeTemplate",
        "title": "HTML Visual Editor: 建立文件主題範本 (doc-style.css)"
      }
    ]
  },
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "compile": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/marked": "^5.0.2",
    "@types/node": "^18.11.9",
    "@types/quill": "^2.0.14",
    "@types/turndown": "^5.0.6",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.19.5",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.3.2"
  },
  "dependencies": {
    "mammoth": "^1.12.0",
    "marked": "^18.0.5",
    "monaco-editor": "^0.50.0",
    "parse5": "^7.1.2",
    "quill": "^2.0.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
